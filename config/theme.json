{
  "_readme": "Colors must be 6-digit hex values. Each color becomes a CSS variable and a Tailwind color named brand-<kebab-name>. Background entries reference color keys.",
  "colors": {
    "bg": "#060A12",
    "surface": "#0E1729",
    "surfaceAlt": "#0A1120",
    "border": "#1B2A47",
    "highlightBorder": "#2B4372",
    "text": "#E8EFFB",
    "muted": "#8FA3C2",
    "subtle": "#9DB0CC",
    "placeholder": "#5E7396",
    "strong": "#FFFFFF",
    "primary": "#2563EB",
    "primaryHover": "#1D4ED8",
    "accent": "#3B82F6",
    "accentLight": "#60A5FA",
    "accentSoft": "#93C5FD",
    "accentDark": "#1E3A8A",
    "accentDeep": "#1E40AF",
    "destructive": "#F87171"
  },
  "radius": "0.3rem",
  "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
  "monoFontFamily": "'JetBrains Mono', 'Fira Code', monospace",
  "backgrounds": {
    "aurora": {
      "colors": [
        "accentDeep",
        "accent",
        "accentDark"
      ],
      "blend": 0.5,
      "amplitude": 1.0,
      "speed": 0.5
    },
    "grainient": {
      "color1": "primary",
      "color2": "accentDark",
      "color3": "bg"
    }
  }
}
